doctype html
html(lang='sr')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    meta(http-equiv='X-UA-Compatible' content='IE=edge')
    title Nova porudžbina - Foto Art
  body(style='margin:0;padding:0;background-color:#f3f5f8;font-family:Arial,Helvetica,sans-serif;color:#253047;-webkit-text-size-adjust:100%;')
    table(role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='background-color:#f3f5f8;')
      tr
        td(align='center' style='padding:32px 16px;')
          table(role='presentation' width='640' cellpadding='0' cellspacing='0' border='0' style='width:100%;max-width:640px;background-color:#ffffff;border-radius:12px;overflow:hidden;')
            tr
              td(style='padding:22px 30px;background-color:#ffffff;')
                table(role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0')
                  tr
                    td
                      a(href='https://fotoartnis.com/' target='_blank' style='text-decoration:none;')
                        img(src='https://fotoartnis.com/wp-content/uploads/2022/04/cropped-art-logo2-1024x339.jpg' width='350' alt='Foto Art Niš' border='0' style='display:block;width:94px;max-width:100%;height:auto;border:0;')
                    td(align='right' style='color:#4338a8;font-size:11px;font-weight:bold;letter-spacing:1.2px;text-transform:uppercase;') Administratorsko obaveštenje
            tr
              td(style='padding:32px 30px 12px;')
                p(style='margin:0 0 8px;color:#4338a8;font-size:12px;font-weight:bold;letter-spacing:1.5px;text-transform:uppercase;') #{data.title}
                h1(style='margin:0;color:#17243a;font-size:25px;line-height:1.3;') #{data.order.ime} #{data.order.prezime}
            tr
              td(style='padding:16px 30px 26px;')
                table(role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='border:1px solid #e4e9f0;border-radius:8px;')
                  if data.order.brojKesice
                    tr
                      td(colspan='2' style='padding:15px 18px;background-color:#f7f8fa;border-bottom:1px solid #e4e9f0;color:#526078;font-size:13px;')
                        | Broj porudžbine:&nbsp;
                        strong(style='color:#17243a;') #{data.order.brojKesice}
                  tr
                    td(style='width:40%;padding:12px 18px;border-bottom:1px solid #e4e9f0;color:#68758a;font-size:13px;') Ime i prezime
                    td(style='padding:12px 18px;border-bottom:1px solid #e4e9f0;color:#253047;font-size:14px;font-weight:bold;') #{data.order.ime} #{data.order.prezime}
                  tr
                    td(style='padding:12px 18px;border-bottom:1px solid #e4e9f0;color:#68758a;font-size:13px;') Telefon
                    td(style='padding:12px 18px;border-bottom:1px solid #e4e9f0;font-size:14px;font-weight:bold;')
                      a(href='tel:#{data.order.telefon}' style='color:#253047;text-decoration:none;') #{data.order.telefon}
                  tr
                    td(style='padding:12px 18px;border-bottom:1px solid #e4e9f0;color:#68758a;font-size:13px;') Email
                    td(style='padding:12px 18px;border-bottom:1px solid #e4e9f0;font-size:14px;font-weight:bold;')
                      a(href='mailto:#{data.order.email}' style='color:#253047;text-decoration:none;') #{data.order.email}
                  tr
                    td(style='padding:12px 18px;border-bottom:1px solid #e4e9f0;color:#68758a;font-size:13px;') Fajlovi / fotografije
                    td(style='padding:12px 18px;border-bottom:1px solid #e4e9f0;color:#253047;font-size:14px;font-weight:bold;') #{data.order.photos.length} fajlova / #{data.order.ukupnoFotografija} fotografija
                  tr
                    td(style='padding:12px 18px;border-bottom:1px solid #e4e9f0;color:#68758a;font-size:13px;') Format
                    td(style='padding:12px 18px;border-bottom:1px solid #e4e9f0;color:#253047;font-size:14px;font-weight:bold;') #{data.order.format}
                  tr
                    td(style='padding:12px 18px;border-bottom:1px solid #e4e9f0;color:#68758a;font-size:13px;') Dostava / preuzimanje
                    td(style='padding:12px 18px;border-bottom:1px solid #e4e9f0;color:#253047;font-size:14px;font-weight:bold;')
                      if data.order.preuzimanje === 'kurirska sluzba'
                        | Kurirska služba
                      else if data.order.preuzimanje === 'radnja centar'
                        | Radnja u centru
                      else if data.order.preuzimanje === 'radnja trosarina'
                        | Radnja na Trošarini
                      else
                        | #{data.order.preuzimanje}
                  if data.order.adresa
                    tr
                      td(style='padding:12px 18px;border-bottom:1px solid #e4e9f0;color:#68758a;font-size:13px;') Adresa dostave
                      td(style='padding:12px 18px;border-bottom:1px solid #e4e9f0;color:#253047;font-size:14px;font-weight:bold;') #{data.order.adresa}
                  tr
                    td(style='padding:15px 18px;color:#253047;font-size:14px;font-weight:bold;') Za naplatu
                    td(style='padding:15px 18px;color:#4338a8;font-size:18px;font-weight:bold;')
                      | #{data.order.racun} RSD
                      if data.order.adresa
                        span(style='display:block;margin-top:4px;color:#8792a2;font-size:11px;font-weight:normal;') + poštarina
                table(role='presentation' cellpadding='0' cellspacing='0' border='0' style='margin:24px auto 0;')
                  tr
                    td(align='center' bgcolor='#4338a8' style='border-radius:6px;')
                      a(href=data.adminOrderUrl target='_blank' style='display:inline-block;padding:14px 24px;color:#ffffff;font-size:14px;font-weight:bold;text-decoration:none;') Otvori pregled porudžbina
            tr
              td(align='center' style='padding:20px 30px;background-color:#000000;color:#c7cfda;font-size:12px;line-height:1.7;')
                a(href='https://fotoartnis.com/' style='color:#ffffff;text-decoration:none;font-weight:bold;') Foto Art Niš
                br
                | Karadžićeva 12, Niš &nbsp;·&nbsp; Bulevar Svetog cara Konstantina bb, lokal 10, Niš
