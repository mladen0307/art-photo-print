doctype html
html(lang='sr')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    meta(http-equiv='X-UA-Compatible' content='IE=edge')
    title Foto Art
  body(style='margin:0;padding:0;background-color:#f3f5f8;font-family:Arial,Helvetica,sans-serif;color:#253047;-webkit-text-size-adjust:100%;')
    table(role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='background-color:#f3f5f8;')
      tr
        td(align='center' style='padding:32px 16px;')
          table(role='presentation' width='600' cellpadding='0' cellspacing='0' border='0' style='width:100%;max-width:600px;background-color:#ffffff;border-radius:12px;overflow:hidden;')
            tr
              td(align='center' style='padding:24px 24px 20px;background-color:#ffffff;')
                a(href='https://fotoartnis.com/' target='_blank' style='text-decoration:none;')
                  img(src='https://fotoartnis.com/wp-content/uploads/2022/04/cropped-art-logo2-1024x339.jpg' width='250' alt='Foto Art Niš' border='0' style='display:block;width:110px;max-width:100%;height:auto;border:0;')
            tr
              td(style='padding:36px 36px 12px;')
                p(style='margin:0 0 10px;color:#4338a8;font-size:12px;font-weight:bold;letter-spacing:1.5px;text-transform:uppercase;') Foto Art Niš
                h1(style='margin:0;color:#4338a8;font-size:26px;line-height:1.3;font-weight:700;') #{data.title}
                p(style='margin:20px 0 0;color:#526078;font-size:16px;line-height:1.6;') Poštovani/a #{data.order.ime} #{data.order.prezime},
                p(style='margin:8px 0 0;color:#526078;font-size:15px;line-height:1.7;')
                  | #{data.message}
            tr
              td(style='padding:16px 36px 28px;')
                table(role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='border:1px solid #e4e9f0;border-radius:8px;')
                  if data.order.brojKesice
                    tr
                      td(colspan='2' style='padding:16px 18px;background-color:#f7f8fa;border-bottom:1px solid #e4e9f0;color:#526078;font-size:13px;')
                        | Broj porudžbine:&nbsp;
                        strong(style='color:#17243a;') #{data.order.brojKesice}
                  tr
                    td(style='padding:14px 18px;border-bottom:1px solid #e4e9f0;color:#68758a;font-size:14px;') Format
                    td(align='right' style='padding:14px 18px;border-bottom:1px solid #e4e9f0;color:#253047;font-size:14px;font-weight:bold;') #{data.order.format}
                  tr
                    td(style='padding:14px 18px;border-bottom:1px solid #e4e9f0;color:#68758a;font-size:14px;') Fotografije
                    td(align='right' style='padding:14px 18px;border-bottom:1px solid #e4e9f0;color:#253047;font-size:14px;font-weight:bold;') #{data.order.ukupnoFotografija}
                  tr
                    td(style='padding:14px 18px;border-bottom:1px solid #e4e9f0;color:#68758a;font-size:14px;') Preuzimanje
                    td(align='right' style='padding:14px 18px;border-bottom:1px solid #e4e9f0;color:#253047;font-size:14px;font-weight:bold;')
                      if data.order.preuzimanje === 'kurirska sluzba'
                        | Kurirska služba
                      else if data.order.preuzimanje === 'radnja centar'
                        | Radnja u centru
                      else if data.order.preuzimanje === 'radnja trosarina'
                        | Radnja na Trošarini
                      else
                        | #{data.order.preuzimanje}
                  if data.order.adresa
                    tr
                      td(style='padding:14px 18px;border-bottom:1px solid #e4e9f0;color:#68758a;font-size:14px;') Adresa dostave
                      td(align='right' style='padding:14px 18px;border-bottom:1px solid #e4e9f0;color:#253047;font-size:14px;font-weight:bold;') #{data.order.adresa}
                  tr
                    td(style='padding:16px 18px;color:#253047;font-size:15px;font-weight:bold;') Za naplatu
                    td(align='right' style='padding:16px 18px;color:#4338a8;font-size:18px;font-weight:bold;')
                      | #{data.order.racun} RSD
                      if data.order.adresa
                        span(style='display:block;margin-top:4px;color:#8792a2;font-size:11px;font-weight:normal;') Poštarina se obračunava posebno.
            tr
              td(style='padding:0 36px 30px;')
                p(style='margin:0;color:#526078;font-size:14px;line-height:1.7;') Hvala vam što ste izabrali Foto Art. Za sva pitanja, slobodno nas kontaktirajte.
                p(style='margin:16px 0 0;color:#253047;font-size:14px;line-height:1.6;font-weight:bold;') Foto Art Niš
            tr
              td(style='padding:24px 36px;background-color:#000000;')
                p(style='margin:0 0 8px;color:#ffffff;font-size:14px;font-weight:bold;') Kontakt
                p(style='margin:0;color:#c7cfda;font-size:12px;line-height:1.8;')
                  a(href='https://fotoartnis.com/' style='color:#ffffff;text-decoration:none;') fotoartnis.com
                  br
                  | Karadžićeva 12, Niš
                  br
                  | Bulevar Svetog cara Konstantina bb, lokal 10, Niš
                  br
                  a(href='tel:+381646475683' style='color:#c7cfda;text-decoration:none;') 064 64 75 683
                  | &nbsp; · &nbsp;
                  a(href='tel:+381641144959' style='color:#c7cfda;text-decoration:none;') 064 11 44 959
                  br
                  a(href='mailto:foto.art.nis@hotmail.com' style='color:#c7cfda;text-decoration:none;') foto.art.nis@hotmail.com
                p(style='margin:18px 0 0;color:#8895a8;font-size:11px;line-height:1.5;') Ova poruka je poslata u vezi sa vašom porudžbinom.
